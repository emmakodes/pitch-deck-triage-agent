OPENAI_API_KEY=

# From the Nango dashboard > Environment Settings
NANGO_SECRET_KEY=

# Connections tab - your own Gmail and Slack connections (Connection Scope in
# CONTEXT.md: one connection-id per provider, per customer; here, both are you)
NANGO_GMAIL_CONNECTION_ID=
NANGO_SLACK_CONNECTION_ID=

# Slack channel to post the notification to - an ID like "C0123456" or a name
# like "#pitch-triage" (the bot/app must be a member of the channel).
# Quote it if it starts with "#" - dotenv treats an unquoted "#" as a comment
# marker and silently drops everything after it.
SLACK_CHANNEL="#pitch-triage"
